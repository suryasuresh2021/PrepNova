# Copy this file to .env.local for local development.
# Add the same variables in Vercel: Project Settings > Environment Variables.

# --- Razorpay ---
# Dashboard > Settings > API Keys (use Test Mode keys until you're ready to go live)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# Dashboard > Settings > Webhooks (set the Secret you enter there to this value)
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase ---
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- AI Question Generation (optional) ---
# console.anthropic.com > API Keys — this is YOUR OWN key, separate from any Claude chat,
# and usage is billed to your own Anthropic account. Only needed for the "AI Generate"
# tab in the Question Bank; everything else works without it.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google AdSense (optional) ---
# adsense.google.com — your Publisher ID, format ca-pub-XXXXXXXXXXXXXXXX.
# Ads won't actually show until Google reviews and approves your live site —
# this just wires the code up so it's ready the moment approval comes through.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
